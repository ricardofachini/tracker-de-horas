/* Tracker Horas — folha de estilo com tokens (@nome).
   As cores reais são injetadas por theme.cpp conforme o modo claro/escuro. */

* {
    font-family: "Cantarell", "Adwaita Sans", "Ubuntu", "Noto Sans", sans-serif;
    font-size: 14px;
    color: @text;
    outline: none;
}

QMainWindow, QStackedWidget, QScrollArea, QScrollArea > QWidget > QWidget {
    background: @window;
}

/* ------------------------------------------------------------- Sidebar */

QFrame#sidebar {
    background: @sidebar;
    border-right: 1px solid @sidebarBorder;
}

QLabel#appTitle {
    font-size: 18px;
    font-weight: 700;
    background: transparent;
}

QLabel#appSubtitle {
    font-size: 12px;
    color: @textMuted;
    background: transparent;
}

QPushButton[nav="true"] {
    text-align: left;
    padding: 10px 14px;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: @textSoft;
    font-weight: 500;
}
QPushButton[nav="true"]:hover { background: @hover; }
QPushButton[nav="true"]:checked {
    background: @accentSoft;
    color: @accentStrong;
    font-weight: 700;
}

/* --------------------------------------------------------------- Cards */

QFrame[card="true"] {
    background: @surface;
    border: 1px solid @surfaceBorder;
    border-radius: 16px;
}
QFrame[card="true"] QLabel { background: transparent; }

/* --------------------------------------------------------------- Texto */

QLabel[role="h1"] { font-size: 26px; font-weight: 800; }
QLabel[role="h2"] { font-size: 15px; font-weight: 700; }
QLabel[role="muted"] { font-size: 13px; color: @textMuted; }

QLabel[role="punchTime"] {
    font-family: "Ubuntu Mono", "DejaVu Sans Mono", monospace;
    font-weight: 700;
    color: @textSoft;
}

QLabel[role="taskTime"] { font-size: 12px; color: @textMuted; }
QLabel[role="taskTime"][running="true"] {
    font-family: "Ubuntu Mono", "DejaVu Sans Mono", monospace;
    font-weight: 700;
    color: @successText;
}

QLabel#clockNow {
    font-family: "Ubuntu Mono", "DejaVu Sans Mono", monospace;
    font-size: 20px;
    font-weight: 600;
    color: @textSoft;
}

QLabel#workedLabel {
    font-family: "Ubuntu Mono", "DejaVu Sans Mono", monospace;
    font-size: 54px;
    font-weight: 700;
}
/* O timer acompanha a cor do status (propriedade dinâmica "state"). */
QLabel#workedLabel[state="off"]     { color: @timerOff; }
QLabel#workedLabel[state="working"] { color: @successText; }
QLabel#workedLabel[state="break"]   { color: @warnText; }
QLabel#workedLabel[state="done"]    { color: @accentStrong; }

QLabel#statValue { font-size: 28px; font-weight: 800; }

/* ------------------------------------------------------- Banco de horas */

QLabel#bankTotal { font-size: 44px; font-weight: 800; }

/* Saldos coloridos (propriedade dinâmica "balance"): crédito verde,
   débito vermelho, zerado neutro e âmbar para o dia em andamento. */
QLabel[balance="credit"]  { color: @successText; }
QLabel[balance="debit"]   { color: @dangerText; }
QLabel[balance="zero"]    { color: @textMuted; }
QLabel[balance="partial"] { color: @warnText; }

QLabel#balancePill {
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 700;
    background: @track;
    color: @textMuted;
}
QLabel#balancePill[balance="credit"]  { background: @successSoft; color: @successText; }
QLabel#balancePill[balance="debit"]   { background: @dangerSoft;  color: @dangerText; }
QLabel#balancePill[balance="partial"] { background: @warnSoft;    color: @warnText; }

/* -------------------------------------------------------- Pílula status */

QLabel#statusPill {
    padding: 5px 14px;
    border-radius: 13px;
    font-size: 13px;
    font-weight: 600;
    background: @track;
    color: @textMuted;
}
QLabel#statusPill[state="working"] { background: @successSoft; color: @successText; }
QLabel#statusPill[state="break"]   { background: @warnSoft; color: @warnText; }
QLabel#statusPill[state="done"]    { background: @accentSoft; color: @accentStrong; }

/* --------------------------------------------------------------- Botões */

QPushButton[kind] {
    border: none;
    border-radius: 10px;
    padding: 11px 22px;
    font-weight: 600;
}

QPushButton[kind="primary"] { background: @accent; color: #ffffff; }
QPushButton[kind="primary"]:hover { background: @accentHover; }
QPushButton[kind="primary"]:pressed { background: @accentPressed; }

QPushButton[kind="success"] { background: @success; color: #ffffff; }
QPushButton[kind="success"]:hover { background: @successHover; }
QPushButton[kind="success"]:pressed { background: @successPressed; }

QPushButton[kind="neutral"] {
    background: @surface;
    border: 1px solid @inputBorder;
    color: @textBody;
}
QPushButton[kind="neutral"]:hover { background: @hoverSolid; }
QPushButton[kind="neutral"]:pressed { background: @pressedSolid; }

QPushButton[kind="danger"] { background: @dangerSoft; color: @dangerText; }
QPushButton[kind="danger"]:hover { background: @dangerSoftHover; }
QPushButton[kind="danger"]:pressed { background: @dangerSoftPressed; }

QPushButton[kind="ghost"] {
    background: transparent;
    color: @textMuted;
    padding: 6px 10px;
    font-weight: 500;
}
QPushButton[kind="ghost"]:hover { color: @dangerText; }

/* Variante baixa do neutro, para rodapés e barras compactas. */
QPushButton[kind="compact"] {
    background: @surface;
    border: 1px solid @inputBorder;
    border-radius: 10px;
    padding: 7px 14px;
    font-weight: 600;
    color: @textBody;
}
QPushButton[kind="compact"]:hover { background: @hoverSolid; }
QPushButton[kind="compact"]:pressed { background: @pressedSolid; }

/* Botões de ação nas linhas de lista (editar, remover, iniciar, pausar). */
QToolButton[rowAction="true"] {
    border: none;
    border-radius: 7px;
    background: transparent;
}
QToolButton[rowAction="true"]:hover { background: @hover; }
QToolButton[rowAction="true"]:pressed { background: @pressedSolid; }

/* -------------------------------------------------------------- Jornada */

QProgressBar#journeyBar {
    background: @track;
    border: none;
    border-radius: 3px;
}
QProgressBar#journeyBar::chunk {
    background: @accent;
    border-radius: 3px;
}
QProgressBar#journeyBar[complete="true"]::chunk { background: @success; }

/* --------------------------------------------------------------- Campos */

QLineEdit {
    background: @surface;
    border: 1px solid @inputBorder;
    border-radius: 10px;
    padding: 9px 12px;
    selection-background-color: @accent;
    selection-color: #ffffff;
}
QLineEdit:focus { border: 2px solid @accent; padding: 8px 11px; }

QTimeEdit {
    background: @surface;
    border: 1px solid @inputBorder;
    border-radius: 10px;
    padding: 8px 12px;
    selection-background-color: @accent;
    selection-color: #ffffff;
}
QTimeEdit:focus { border: 2px solid @accent; padding: 7px 11px; }

QComboBox {
    background: @surface;
    border: 1px solid @inputBorder;
    border-radius: 10px;
    padding: 8px 12px;
}
QComboBox:focus { border: 2px solid @accent; padding: 7px 11px; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { image: url(:/arrow-down.svg); width: 10px; height: 6px; }
QComboBox QAbstractItemView {
    background: @surface;
    border: 1px solid @surfaceBorder;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: @accentSoft;
    selection-color: @accentStrong;
}

/* --------------------------------------------------------------- Diálogos */

QDialog { background: @window; }

/* Checkbox das tarefas (mesmo desenho do indicador das listas). */
QCheckBox { background: transparent; spacing: 10px; color: @textBody; }
QCheckBox[done="true"] { color: @textMuted; }
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 2px solid @faint;
    background: @surface;
}
QCheckBox::indicator:hover { border-color: @accent; }
QCheckBox::indicator:checked {
    background: @accent;
    border-color: @accent;
    image: url(:/check.svg);
}

/* Radio buttons (diálogo de turno aberto), no desenho do checkbox. */
QRadioButton { background: transparent; spacing: 10px; color: @textBody; }
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border-radius: 9px;
    border: 2px solid @faint;
    background: @surface;
}
QRadioButton::indicator:hover { border-color: @accent; }
QRadioButton::indicator:checked {
    width: 8px;
    height: 8px;
    border: 5px solid @accent;
    background: #ffffff;
}

/* --------------------------------------------------------------- Listas */

QListWidget {
    background: transparent;
    border: none;
}
/* As linhas são widgets embutidos (setItemWidget); padding no item
   deslocaria/cortaria o widget — o respiro vem das margens da linha. */
QListWidget::item {
    padding: 0px;
    border-bottom: 1px solid @separator;
    color: @textBody;
}
QListWidget::item:hover { background: @surfaceHover; }
QListWidget::item:selected { background: transparent; color: @textBody; }

QListWidget::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 2px solid @faint;
    background: @surface;
}
QListWidget::indicator:hover { border-color: @accent; }
QListWidget::indicator:checked {
    background: @accent;
    border-color: @accent;
    image: url(:/check.svg);
}

/* ------------------------------------------------------- Folha de ponto */

QPushButton#monthNav {
    background: @surface;
    border: 1px solid @inputBorder;
    border-radius: 10px;
    padding: 4px 12px;
    font-size: 16px;
    font-weight: 600;
}
QPushButton#monthNav:hover { background: @hoverSolid; }
QPushButton#monthNav:disabled {
    color: @faint;
    background: @window;
    border-color: @sidebarBorder;
}

QLabel#monthLabel { font-size: 15px; font-weight: 700; }

QTableView {
    background: transparent;
    border: none;
    alternate-background-color: @altRow;
}
QHeaderView::section {
    background: transparent;
    border: none;
    border-bottom: 2px solid @surfaceBorder;
    padding: 8px;
    font-size: 12px;
    font-weight: 700;
    color: @textMuted;
}

/* ------------------------------------------------------------ Scrollbar */

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: @scroll;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: @scrollHover; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QToolTip {
    background: @tooltipBg;
    color: @tooltipText;
    border: none;
    padding: 6px 8px;
    border-radius: 6px;
}
